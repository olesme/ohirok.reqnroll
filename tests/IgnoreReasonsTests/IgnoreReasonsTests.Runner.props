<Project>

  <!-- Shared by every IgnoreReasons runner project (NUnit, MSTest, xUnit v3, TUnit). -->
  <Import Project="..\Ohirok.RunnerSuite.props" />

  <ItemGroup>
    <!-- Generator only: built first, but nothing of it reaches the test output (as with the package). -->
    <ProjectReference Include="$(OhirokRepoRootDir)src\IgnoreReasons\Ohirok.IgnoreReasons.ReqnrollPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ReqnrollGeneratorPlugins Include="$(OhirokRepoRootDir)src\IgnoreReasons\bin\$(Configuration)\netstandard2.0\Ohirok.IgnoreReasons.ReqnrollPlugin.dll" />
    <ProjectReference Include="$(OhirokRepoRootDir)src\Reporting\Ohirok.Reporting.ReqnrollPlugin\Ohirok.Reporting.ReqnrollPlugin.csproj" />
  </ItemGroup>

</Project>
