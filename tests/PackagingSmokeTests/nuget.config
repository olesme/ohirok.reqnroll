<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
    <clear /> drops any feed configured higher up the directory tree or machine-wide, so a smoke run
    can only resolve the Ohirok packages from the local feed built by pack-local-feed - never from a
    stale copy in some other source.
    -->
    <clear />
    <add key="ohirok-smoke-feed" value=".localfeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
