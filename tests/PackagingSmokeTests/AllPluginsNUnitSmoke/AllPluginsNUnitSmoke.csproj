<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="nunit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
    All four plugins at once. StepHashtags is listed explicitly here even though XFail already brings
    it in transitively - that overlap is the point, since it is the shape a real consumer ends up with
    once they install more than one plugin.
    -->
    <PackageReference Include="Ohirok.StepHashtags.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
    <PackageReference Include="Ohirok.XFail.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
    <PackageReference Include="Ohirok.Retry.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
    <PackageReference Include="Ohirok.SoftAssert.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
    <!-- Generator only: the package carries its assembly in build/, so nothing of it may reach the output. -->
    <PackageReference Include="Ohirok.Variants.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
    <PackageReference Include="Ohirok.AutoTags.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
  </ItemGroup>

</Project>
