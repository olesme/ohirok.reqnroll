<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="nunit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
    Only the XFail package is referenced. Ohirok.StepHashtags.ReqnrollPlugin arrives transitively and
    has to activate its own generator plugin with no help from this project - that is the behaviour
    under test, and the reason there is no ReqnrollGeneratorPlugins item anywhere in this file.
    -->
    <PackageReference Include="Ohirok.XFail.ReqnrollPlugin" Version="$(OhirokSmokeVersion)" />
  </ItemGroup>

</Project>
