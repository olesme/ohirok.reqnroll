<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Generator only: Reqnroll's generator loads it at build time (netstandard2.0 serves both MSBuild hosts). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Reqnroll plugin that tags scenarios by their steps: configure step-text patterns in reqnroll.json and every scenario using such a step (directly or in its Background) gets the tag, in the generated test, in runner categories, for tag-scoped hooks and in Cucumber messages. Built on the Ohirok Reqnroll plugin SDK.</Description>
    <PackageTags>reqnroll bdd gherkin cucumber test-automation tags categories hooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
    Like Reqnroll's own generator plugins, the package carries the assembly in build/netstandard2.0 instead of lib/:
    a consuming test project neither compiles against it nor copies it to its output, so Reqnroll's runtime never
    sees a *.ReqnrollPlugin.dll without a runtime plugin in it. Its dependencies (the SDK) go next to it, described
    by its deps.json, which is how Reqnroll's generator resolves a plugin's dependencies.
    The package still depends on the SDK package: that keeps NuGet from choosing an older SDK for the project, and the
    SDK package's buildTransitive targets make the generator load that SDK first.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_OhirokPackGeneratorOnlyPlugin</TargetsForTfmSpecificContentInPackage>
    <!-- No lib/ assembly, so a symbols package would be empty (NU5017); the pdb ships next to the dll instead. -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build\Ohirok.AutoTags.ReqnrollPlugin.props" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginChains.Sdk\Ohirok.Reqnroll.PluginChains.Sdk.csproj" />
  </ItemGroup>

  <Target Name="_OhirokPackGeneratorOnlyPlugin" DependsOnTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_OhirokGeneratorFile Include="$(TargetPath);$(ProjectDepsFilePath)" />
      <_OhirokGeneratorFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <!-- Same filter as GeneratorPluginPackaging.targets: everything the generator host does not provide. -->
      <_OhirokGeneratorFile Include="@(ReferenceCopyLocalPaths)" Condition="
          '%(Extension)' == '.dll' and
          !$([System.String]::Copy('%(Filename)').StartsWith('Reqnroll')) and
          !$([System.String]::Copy('%(Filename)').StartsWith('System.')) and
          !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.')) and
          !$([System.String]::Copy('%(Filename)').StartsWith('Cucumber')) and
          '%(Filename)' != 'Gherkin' and
          '%(Filename)' != 'netstandard'" />
      <TfmSpecificPackageFile Include="@(_OhirokGeneratorFile)" PackagePath="build/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

</Project>
